def generate_password_strong(length):
    if length < 4:
        return "Слишком короткий пароль (нужно минимум 4 символа)"
    
    lower = random.choice(string.ascii_lowercase)
    upper = random.choice(string.ascii_uppercase)
    digit = random.choice(string.digits)
    punct = random.choice(string.punctuation)
    
    others = [random.choice(string.ascii_letters + string.digits + string.punctuation) for _ in range(length - 4)]
    
    password_list = [lower, upper, digit, punct] + others
    random.shuffle(password_list)
    
    return ''.join(password_list)
